{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/routeTree.gen.ts", "reference/**", "packages/three-dlss-nr/vendor/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "react", "jsx-a11y"],
  "rules": {
    "eslint/no-underscore-dangle": "off",
    "eslint/no-unused-private-class-members": "error",
    "react/react-in-jsx-scope": "off",
    "unicorn/no-new-array": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "**/test/**", "**/tests/**"],
      "plugins": ["eslint", "typescript", "oxc", "unicorn", "react", "jsx-a11y", "vitest"]
    }
  ]
}
