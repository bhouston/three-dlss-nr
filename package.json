{
  "name": "three-dlss-nr-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "tsc": "node packages/three-dlss-nr/scripts/bundle-reference.mjs && tsc -b",
    "dev": "pnpm --parallel --filter three-dlss-nr --filter website dev",
    "test": "pnpm tsc && vitest run --project unit --coverage",
    "test:gpu": "node packages/three-dlss-nr/scripts/bundle-reference.mjs && vitest run --project gpu",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "prepare": "husky",
    "commitlint": "commitlint",
    "size": "node scripts/check-bundle-size.mjs",
    "release": "semantic-release",
    "release:check": "node --test scripts/release.test.mjs",
    "bench:backends": "node scripts/bench-backends.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.0",
    "@visulima/yaml": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "semantic-release": "^25.0.9",
    "three": "0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^5.0.3",
    "vitest-environment-webgpu-node": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
