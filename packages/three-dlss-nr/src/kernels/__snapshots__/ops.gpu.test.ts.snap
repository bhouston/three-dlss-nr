		nodeVar# = nr_f16_bits( nr_round_f16( ( nr_f16_to_f32( ( ( nr_inF16.value[ ( nodeVar# >> 1u ) ] >> ( ( nodeVar# & 1u ) << 4u ) ) & 65535u ) ) + ( nr_decode_e4m3( ( ( nr_skipE4.value[ ( nodeVar# >> 2u ) ] >> ( ( nodeVar# & 3u ) << 3u ) ) & 255u ) ) * nr_f16_to_f32( ( ( nr_aux.value[ ( nodeVar# >> 1u ) ] >> ( ( nodeVar# & 1u ) << 4u ) ) & 65535u ) ) ) ) ) );
		nr_outE4.value[ ( nodeVar# >> 2u ) ] = ( ( ( nr_encode_e4m3( nodeVar# ) | ( nr_encode_e4m3( nodeVar# ) << 8u ) ) | ( nr_encode_e4m3( nodeVar# ) << 16u ) ) | ( nr_encode_e4m3( nodeVar# ) << 24u ) );
		nodeVar# = ( nodeVar# >> 1u );
		nr_outF16.value[ nodeVar# ] = ( nodeVar# | ( nodeVar# << 16u ) );
		nr_outF16.value[ ( nodeVar# + 1u ) ] = ( nodeVar# | ( nodeVar# << 16u ) );

	}

}
"
`;
