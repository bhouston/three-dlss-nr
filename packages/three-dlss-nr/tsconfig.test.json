{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    "rootDir": "${configDir}",
    "outDir": "${configDir}/node_modules/.cache/tsc-test",
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsc-test/.tsbuildinfo",
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["${configDir}/src/**/*.ts", "${configDir}/test/**/*.ts"],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
